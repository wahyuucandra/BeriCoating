{
  "expo": {
    "name": "BeriCoat",
    "slug": "bericoat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bericoat",
    "icon": "./assets/logo.png",
    "platforms": ["android"],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withBluetoothClassic.js",
      "./plugins/withAdaptiveIconPadding.js",
      "./plugins/withAndroidOptimization.js"
    ],
    "android": {
      "package": "com.acc.bericoat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1976D2"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}